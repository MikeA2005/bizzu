rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Los perfiles son legibles solo por usuarios autenticados.
    // Cada usuario puede crear o modificar únicamente su propio perfil.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Las categorías se consultan al iniciar sesión.
    // La aplicación las crea una sola vez mediante el proceso de inicialización.
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Los productos son visibles únicamente para usuarios autenticados.
    match /products/{productId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid;

      // El vendedor puede editar todos los campos de su publicación.
      // Cualquier autenticado solo puede cambiar el marcador isFavorite.
      allow update: if signedIn()
        && (
          (
            resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == request.auth.uid
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isFavorite'])
          )
        );

      allow delete: if signedIn()
        && resource.data.sellerId == request.auth.uid;
    }

    // Las reseñas son públicas dentro de la aplicación autenticada.
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }
  }
}
